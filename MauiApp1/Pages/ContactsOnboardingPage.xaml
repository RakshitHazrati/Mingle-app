<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MauiApp1.Pages.ContactsOnboardingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiApp1.Models"
             Title="Build your circle">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Padding="20,14,20,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <VerticalStackLayout Spacing="3">
        <Label Text="STEP 2 OF 2" TextColor="#6D3BFF" FontFamily="OpenSansSemibold"
               FontSize="11" CharacterSpacing="1.5" />
        <Label Text="Choose your trusted circle" Style="{StaticResource Title}" FontSize="23" />
        <Label x:Name="ContactSummaryLabel" Text="Only contacts you choose are shared with Mingle."
               Style="{StaticResource BodyMuted}" FontSize="12" />
      </VerticalStackLayout>
      <Button Grid.Column="1" Text="Share code" Style="{StaticResource SecondaryButton}"
              FontSize="12" Padding="13,8" MinimumHeightRequest="42" VerticalOptions="Center"
              Clicked="OnShareClicked" />
    </Grid>

    <Grid Grid.Row="1" Padding="20,4,20,10" RowDefinitions="Auto,Auto" RowSpacing="8">
      <Button x:Name="LoadContactsButton" Text="Open phone contacts"
              MinimumHeightRequest="48" Clicked="OnLoadContactsClicked" />
      <SearchBar x:Name="ContactSearch" Grid.Row="1" IsVisible="False"
                 Placeholder="Search name or phone number" HeightRequest="46"
                 TextChanged="OnSearchTextChanged" />
    </Grid>

    <Grid Grid.Row="2">
      <VerticalStackLayout x:Name="EmptyState" Padding="34" Spacing="10" VerticalOptions="Center">
        <Label Text="☎" FontSize="44" HorizontalTextAlignment="Center" />
        <Label Text="Your contacts stay in your control" Style="{StaticResource SectionTitle}"
               HorizontalTextAlignment="Center" />
        <Label Text="After you grant access, choose contacts here. Unselected contacts are never sent to Mingle."
               Style="{StaticResource BodyMuted}" FontSize="12" HorizontalTextAlignment="Center" />
      </VerticalStackLayout>

      <CollectionView x:Name="ContactsList" Margin="14,0" IsVisible="False"
                      SelectionMode="Multiple" SelectionChanged="OnSelectionChanged"
                      ItemsUpdatingScrollMode="KeepScrollOffset">
        <CollectionView.EmptyView>
          <VerticalStackLayout Padding="28" Spacing="8" VerticalOptions="Center">
            <Label Text="No matching contacts" Style="{StaticResource SectionTitle}"
                   HorizontalTextAlignment="Center" />
            <Label Text="Try another name or phone number." Style="{StaticResource BodyMuted}"
                   HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="models:DeviceContactCard">
            <Border Stroke="#E7E1ED" StrokeShape="RoundRectangle 16" Padding="10" Margin="5,3">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup Name="CommonStates">
                  <VisualState Name="Normal">
                    <VisualState.Setters>
                      <Setter Property="BackgroundColor" Value="White" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState Name="Selected">
                    <VisualState.Setters>
                      <Setter Property="BackgroundColor" Value="#EEE9FF" />
                      <Setter Property="Stroke" Value="#6D3BFF" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21"
                        BackgroundColor="#6D3BFF">
                  <Label Text="{Binding Initials}" TextColor="White" FontFamily="OpenSansSemibold"
                         HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                  <Label Text="{Binding DisplayName}" FontFamily="OpenSansSemibold"
                         MaxLines="1" LineBreakMode="TailTruncation" />
                  <Label Text="{Binding MaskedPhone}" Style="{StaticResource BodyMuted}" FontSize="11" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="Select" TextColor="#6D3BFF" FontFamily="OpenSansSemibold"
                       FontSize="11" VerticalOptions="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Grid x:Name="LoadingOverlay" IsVisible="False" BackgroundColor="#D9FAF8FD">
        <Border Style="{StaticResource Card}" Padding="22" HorizontalOptions="Center" VerticalOptions="Center">
          <VerticalStackLayout Spacing="10">
            <ActivityIndicator IsRunning="True" Color="#6D3BFF" WidthRequest="34" HeightRequest="34" />
            <Label Text="Preparing your contacts…" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
            <Label Text="Large contact lists can take a moment." Style="{StaticResource BodyMuted}"
                   FontSize="11" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>
        </Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="3" Padding="20,9,20,14" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
          RowSpacing="6" ColumnSpacing="10" BackgroundColor="#FAF8FD">
      <Label x:Name="SelectionLabel" Text="No contacts selected" VerticalTextAlignment="Center"
             Style="{StaticResource BodyMuted}" FontSize="11" />
      <Button Grid.Column="1" Text="Do this later" Style="{StaticResource GhostButton}"
              FontSize="11" Padding="8,4" MinimumHeightRequest="32" Clicked="OnSkipClicked" />
      <Button x:Name="ContinueButton" Grid.Row="1" Grid.ColumnSpan="2" Text="Add selected contacts"
              MinimumHeightRequest="48" IsEnabled="False" Clicked="OnContinueClicked" />
    </Grid>
  </Grid>
</ContentPage>
