<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MauiApp1.Pages.ContactsOnboardingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiApp1.Models"
             Title="Build your circle">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <VerticalStackLayout Padding="24,20,24,12" Spacing="9">
      <Label Text="STEP 2 OF 2" TextColor="#6D3BFF" FontFamily="OpenSansSemibold"
             FontSize="12" CharacterSpacing="2" />
      <Label Text="Choose your trusted circle" Style="{StaticResource Title}" />
      <Label Text="Mingle reads contacts only after permission. Select exactly who should join your private circle."
             Style="{StaticResource BodyMuted}" FontSize="13" />
    </VerticalStackLayout>

    <Grid Grid.Row="1" Padding="24,4,24,12" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Button x:Name="LoadContactsButton" Text="Open phone contacts" Clicked="OnLoadContactsClicked" />
      <Button Grid.Column="1" Text="Share code" Style="{StaticResource SecondaryButton}" Clicked="OnShareClicked" />
    </Grid>

    <Grid Grid.Row="2">
      <VerticalStackLayout x:Name="EmptyState" Padding="34" Spacing="10" VerticalOptions="Center">
        <Label Text="☎" FontSize="44" HorizontalTextAlignment="Center" />
        <Label Text="Your contacts stay in your control" Style="{StaticResource SectionTitle}"
               HorizontalTextAlignment="Center" />
        <Label Text="After you grant access, choose contacts here. Unselected contacts are never sent to Mingle."
               Style="{StaticResource BodyMuted}" FontSize="12" HorizontalTextAlignment="Center" />
      </VerticalStackLayout>

      <CollectionView x:Name="ContactsList" Margin="18,0" IsVisible="False"
                      SelectionMode="Multiple" SelectionChanged="OnSelectionChanged">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="models:DeviceContactCard">
            <Border Stroke="#E7E1ED" StrokeShape="RoundRectangle 18" Padding="14" Margin="6">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup Name="CommonStates">
                  <VisualState Name="Normal">
                    <VisualState.Setters>
                      <Setter Property="BackgroundColor" Value="White" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState Name="Selected">
                    <VisualState.Setters>
                      <Setter Property="BackgroundColor" Value="#EEE9FF" />
                      <Setter Property="Stroke" Value="#6D3BFF" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="12">
                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24"
                        BackgroundColor="#6D3BFF">
                  <Label Text="{Binding Initials}" TextColor="White" FontFamily="OpenSansSemibold"
                         HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                  <Label Text="{Binding DisplayName}" FontFamily="OpenSansSemibold" />
                  <Label Text="{Binding MaskedPhone}" Style="{StaticResource BodyMuted}" FontSize="11" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="Select" TextColor="#6D3BFF" FontFamily="OpenSansSemibold"
                       FontSize="11" VerticalOptions="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </Grid>

    <VerticalStackLayout Grid.Row="3" Padding="24,12,24,24" Spacing="8" BackgroundColor="#FAF8FD">
      <Label x:Name="SelectionLabel" Text="No contacts selected" HorizontalTextAlignment="Center"
             Style="{StaticResource BodyMuted}" FontSize="11" />
      <Button x:Name="ContinueButton" Text="Add selected contacts" IsEnabled="False" Clicked="OnContinueClicked" />
      <Button Text="I’ll do this later" Style="{StaticResource GhostButton}" HeightRequest="42" Clicked="OnSkipClicked" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
