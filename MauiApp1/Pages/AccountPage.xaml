<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MauiApp1.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <ScrollView>
    <VerticalStackLayout Padding="22,20,22,34" Spacing="18">
      <Label Text="You" Style="{StaticResource Title}" />
      <Border Style="{StaticResource Card}" Padding="20">
        <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
          <Border WidthRequest="70" HeightRequest="70" StrokeThickness="0" StrokeShape="RoundRectangle 35">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6D3BFF" Offset="0" />
                <GradientStop Color="#FF5C8A" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Label x:Name="InitialsLabel" Text="RS" TextColor="White" FontFamily="OpenSansSemibold"
                     FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
              <Image x:Name="AccountProfileImage" IsVisible="False" Aspect="AspectFill" />
            </Grid>
          </Border>
          <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
            <Label x:Name="NameLabel" Text="Riya Sharma" FontFamily="OpenSansSemibold" FontSize="20" />
            <Label x:Name="ProfileSummaryLabel" Text="Complete your profile" Style="{StaticResource BodyMuted}" FontSize="11" />
            <ProgressBar x:Name="ProfileProgress" Progress="0" ProgressColor="#6D3BFF" BackgroundColor="#E8E2EE" />
          </VerticalStackLayout>
        </Grid>
      </Border>

      <Button Text="Edit profile" Style="{StaticResource SecondaryButton}" Clicked="OnEditProfileClicked" />

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="9">
        <Border Style="{StaticResource Card}" Padding="12">
          <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
            <Label x:Name="PointsLabel" Text="240" FontFamily="OpenSansSemibold" FontSize="20" TextColor="#6D3BFF" />
            <Label Text="points" Style="{StaticResource BodyMuted}" FontSize="10" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
          <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
            <Label x:Name="FriendsCountLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="20" TextColor="#FF5C8A" />
            <Label Text="friends" Style="{StaticResource BodyMuted}" FontSize="10" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
          <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
            <Label x:Name="IntroducedCountLabel" Text="0" FontFamily="OpenSansSemibold" FontSize="20" TextColor="#22A06B" />
            <Label Text="introduced" Style="{StaticResource BodyMuted}" FontSize="10" />
          </VerticalStackLayout>
        </Border>
      </Grid>

      <Label Text="Invite your people" Style="{StaticResource SectionTitle}" />
      <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="18">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EEE9FF" Offset="0" />
            <GradientStop Color="#FFE7EF" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <VerticalStackLayout Spacing="12">
          <Label Text="Your circle code" Style="{StaticResource BodyMuted}" FontSize="11" />
          <Label x:Name="ReferralLabel" Text="MINGLE-RIYA" FontFamily="OpenSansSemibold" FontSize="24" CharacterSpacing="2" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="Copy" Style="{StaticResource SecondaryButton}" Clicked="OnCopyClicked" />
            <Button Grid.Column="1" Text="Share invite" Clicked="OnShareClicked" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <Label Text="Privacy &amp; safety" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="15">
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
              <Label Text="Contact privacy" FontFamily="OpenSansSemibold" FontSize="13" />
              <Label Text="Only one-way hashes are synced" Style="{StaticResource BodyMuted}" FontSize="10" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="Protected" TextColor="#22A06B" FontFamily="OpenSansSemibold" FontSize="11" />
          </Grid>
          <BoxView HeightRequest="1" Color="#ECE7F2" />
          <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
              <Label Text="Blocked accounts" FontFamily="OpenSansSemibold" FontSize="13" />
              <Label Text="Manage who can reach you" Style="{StaticResource BodyMuted}" FontSize="10" />
            </VerticalStackLayout>
            <Label Grid.Column="1" Text="›" FontSize="24" TextColor="#8A8295" />
          </Grid>
        </VerticalStackLayout>
      </Border>

      <Button Text="Restart onboarding" Style="{StaticResource GhostButton}" Clicked="OnRestartClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
