<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MauiApp1</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Mingle</ApplicationTitle>
    <ApplicationId>com.mingleorg.mingle</ApplicationId>
    <ApplicationDisplayVersion>0.2.1</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>
    <MingleApiBaseUrl Condition="'$(MingleApiBaseUrl)'=='' and '$(Configuration)'=='Debug'">http://10.0.2.2:5088/</MingleApiBaseUrl>
    <MingleApiBaseUrl Condition="'$(MingleApiBaseUrl)'=='' and '$(Configuration)'!='Debug'">https://replace-before-release.invalid/</MingleApiBaseUrl>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MingleApiBaseUrl</_Parameter1>
      <_Parameter2>$(MingleApiBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ValidateMingleReleaseApiUrl" BeforeTargets="Build"
          Condition="'$(Configuration)'=='Release' and $([System.String]::Copy('$(MingleApiBaseUrl)').Contains('replace-before-release.invalid'))">
    <Error Text="A public HTTPS MingleApiBaseUrl is required for a Release build." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6D3BFF" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#6D3BFF" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <!-- Retain the 2024 prototype for reference without compiling it into the rebuilt product. -->
  <ItemGroup>
    <Compile Remove="ContactDetails.cs;EmailService.cs;JwtService.cs;LogIn.xaml.cs;MainPage.xaml.cs;MongoDbContext.cs;MyDatesPage.xaml.cs;OtpPage.xaml.cs;PlayCupidInvitePage.xaml.cs;PlayCupidMembersPage.xaml.cs;ProfilePage.xaml.cs;ReferralPage.xaml.cs;SignUpPage.xaml.cs;UserJwtTocken.cs;UserProfile.cs;Views\**\*.cs" />
    <MauiXaml Remove="LogIn.xaml;MainPage.xaml;MyDatesPage.xaml;OtpPage.xaml;PlayCupidInvitePage.xaml;PlayCupidMembersPage.xaml;ProfilePage.xaml;ReferralPage.xaml;SignUpPage.xaml;Views\**\*.xaml" />
  </ItemGroup>
</Project>
