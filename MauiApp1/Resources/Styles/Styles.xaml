<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Style TargetType="Page" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{StaticResource Canvas}" />
  </Style>
  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="Display" TargetType="Label">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="LineHeight" Value="1.08" />
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
  </Style>
  <Style x:Key="Title" TargetType="Label">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="25" />
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="Label">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
  </Style>
  <Style x:Key="BodyMuted" TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource Muted}" />
    <Setter Property="LineHeight" Value="1.3" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextColor" Value="White" />
    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="HeightRequest" Value="54" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="TextColor" Value="{StaticResource Primary}" />
    <Setter Property="BackgroundColor" Value="#EEE9FF" />
  </Style>
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
  </Style>
  <Style TargetType="Entry">
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HeightRequest" Value="52" />
  </Style>
  <Style TargetType="Editor">
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
  </Style>
  <Style TargetType="Picker">
    <Setter Property="TextColor" Value="{StaticResource Ink}" />
    <Setter Property="TitleColor" Value="{StaticResource Gray500}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
    <Setter Property="Stroke" Value="{StaticResource Line}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeShape" Value="RoundRectangle 24" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style TargetType="Shell" ApplyToDerivedTypes="True">
    <Setter Property="Shell.BackgroundColor" Value="{StaticResource Surface}" />
    <Setter Property="Shell.ForegroundColor" Value="{StaticResource Primary}" />
    <Setter Property="Shell.TitleColor" Value="{StaticResource Ink}" />
    <Setter Property="Shell.NavBarIsVisible" Value="False" />
    <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
    <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
    <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}" />
    <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray500}" />
  </Style>
</ResourceDictionary>
